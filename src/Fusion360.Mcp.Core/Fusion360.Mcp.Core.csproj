<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared models are used by the net10 MCP server and the test
         projects alike: System.Text.Json is the only
         runtime dependency (PLAN.md D2: no external dependencies beyond
         System.Text.Json). -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single source of truth for the tool catalog (PLAN.md D6):
         generated by scripts/generate_tool_catalog.py, embedded as a
         resource, consumed by ToolCatalog. -->
    <EmbeddedResource Include="Catalog\tools_catalog.json" />
  </ItemGroup>

</Project>
