<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fusion360.Mcp.Core\Fusion360.Mcp.Core.csproj" />
  </ItemGroup>

  <!-- D3: adsk .NET assemblies from thirdparty/adsk/ (see thirdparty/adsk/README.md).
       Currently a committed compile-time stub (adsknet.dll) so the project
       compiles on any host without a Fusion install. CopyLocal=false keeps
       the adsk assembly out of the build output: at runtime the add-in
       resolves adsknet in-process from the Fusion runtime, so the stub must
       never ship into the AddIns folder. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\thirdparty\adsk')">
    <Reference Include="..\..\thirdparty\adsk\*.dll" CopyLocal="false" HintPath="..\..\thirdparty\adsk\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Add-in manifest, deployed alongside the DLLs into the Windows Fusion
         AddIns folder by scripts/install-addon.ps1. The macOS shell installer
         installs the reference Python add-in instead. -->
    <Content Include="Fusion360MCP.manifest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
